# Copy to .env.local for local development (API on port 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match the API server — lets Next.js SSR fetch /api/catalog without browser Origin (mirror-site protection)
# STOREFRONT_SSR_SECRET=use_a_long_random_string_here

# Production (example — use your real API and site URLs)
# NEXT_PUBLIC_API_URL=https://api.kcjewellers.co.in
# NEXT_PUBLIC_SITE_URL=https://kcjewellers.co.in

# WhatsApp: digits only, country code included, no + (e.g. 9198XXXXXXXX). Enables the floating “Chat on WhatsApp” button.
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=9198XXXXXXXX

# ERP automatic PDF send (Meta WhatsApp Cloud API) — server-side only unless noted
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret
# META_WHATSAPP_CONFIG_ID=embedded_signup_config_id_from_meta
# WHATSAPP_DOCUMENT_TEMPLATE_NAME=document_delivery
# WHATSAPP_DOCUMENT_TEMPLATE_LANGUAGE=en
# Per-reseller fallback (optional — each shop usually connects in ERP → Integrations):
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_string_for_meta_webhook
# API_PUBLIC_URL=https://api.kcjewellers.co.in
# GOOGLE_CALLBACK_URL=https://kcjewellers.co.in/auth/google/callback
# CLIENT_URL=https://kcjewellers.co.in
#
# API server only — B2B NEFT bank details (shown on proforma / checkout success; never hardcode in client source)
# B2B_BANK_ACCOUNT_NAME=
# B2B_BANK_NAME=
# B2B_BANK_ACCOUNT_NUMBER=
# B2B_BANK_IFSC=
# B2B_BANK_UPI_ID=
# B2B_BANK_NOTES=
